version: '3.8'

services:
  # Angular Frontend - Development
  angular-dev:
    image: 248189916187.dkr.ecr.us-west-2.amazonaws.com/caldev-frontend:latest
    ports:
      - "4200:4200"
    environment:
      - NODE_ENV=development
    networks:
      - caldev-network

  # Angular Frontend - Production
  angular-prod:
    image: 248189916187.dkr.ecr.us-west-2.amazonaws.com/caldev-frontend:latest
    ports:
      - "8080:80"
    networks:
      - caldev-network
    profiles:
      - production

  # PHP Backend
  php-backend:
    image: 248189916187.dkr.ecr.us-west-2.amazonaws.com/caldev-backend:latest
    ports:
      - "8000:80"
    environment:
      - PHP_ENV=development
    networks:
      - caldev-network

networks:
  caldev-network:
    driver: bridge
