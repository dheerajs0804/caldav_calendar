{
    "name": "mithi/caldev-calendar-backend",
    "description": "CalDAV Calendar Application Backend",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0",
        "psr/log-implementation": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.8",
        "infection/infection": "^0.26",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "CalDev\\Calendar\\": "src/",
            "CalDev\\Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CalDev\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:unit": "phpunit tests/Unit",
        "test:integration": "phpunit tests/Integration",
        "test:feature": "phpunit tests/Feature",
        "lint": "phpcs --standard=PSR12 src/",
        "lint:fix": "phpcbf --standard=PSR12 src/",
        "analyze": "phpstan analyse src/ --level=8",
        "infection": "infection --threads=4",
        "quality": [
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

